<?xml version="1.0" encoding="utf-8"?>
<!--
    TrackIt's Room database holds parsed bank/UPI transactions. Excluding it from
    both cloud backup and device-to-device transfer keeps that financial history
    off Google's servers and out of transfer bundles; expenses are already synced
    to the user's own backend, so nothing is lost by opting out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
