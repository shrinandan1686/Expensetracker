/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trackit-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		// The path to the directory containing the `index.html` file to be served at `/`
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Non-secret defaults. FIREBASE_PROJECT_ID is a placeholder on purpose so the
	// repo does not point at anyone's live Firebase project — override it locally
	// in `.dev.vars` (which takes precedence over `vars` in `wrangler dev`) and in
	// production with `npx wrangler secret put FIREBASE_PROJECT_ID`.
	"vars": {
		"MONGODB_DATABASE": "trackit",
		"FIREBASE_PROJECT_ID": "your-firebase-project-id"
	}
}
